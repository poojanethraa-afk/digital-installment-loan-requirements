        <mxCell id="e1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E24B4A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="303" y="423" width="14" height="14" as="geometry" /></mxCell>
